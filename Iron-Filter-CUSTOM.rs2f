apply (area:[3838,6432,0,3896,6465,3] && name:HIDE_OPULENT_SALVAGE) {hidden=true;}

#define HIDE_LIST name:HIDE_USER

#define AREA_UNHIDE(_hidecondition) apply (_hidecondition && (HIDE_LIST)) {hidden = false; hideOverlay = true; menuSort = -50000;} \
apply (_hidecondition && name:HIDE_USER_UNNOTED && stackable:false) {hidden = false; hideOverlay = true; menuSort = -50000;} \
apply (_hidecondition && name:HIDE_USER_UNDER_10 && quantity:<10) {hidden = false; hideOverlay = true; menuSort = -50000;} \
apply (_hidecondition && name:HIDE_USER_UNDER_100 && quantity:<100) {hidden = false; hideOverlay = true; menuSort = -50000;} \
apply (_hidecondition && name:HIDE_USER_UNDER_1000 && quantity:<1000) {hidden = false; hideOverlay = true; menuSort = -50000;} \
apply (_hidecondition && name:HIDE_USER_UNDER_10000 && quantity:<10000) {hidden = false; hideOverlay = true; menuSort = -50000;}

#define UIM_FALLBACK_VALUE_SS 10000000
#define UIM_FALLBACK_VALUE_S 1000000
#define UIM_FALLBACK_VALUE_A 100000
#define UIM_FALLBACK_VALUE_B 10000
#define UIM_FALLBACK_VALUE_C 1000
#define UIM_FALLBACK_VALUE_D 100
#define UIM_FALLBACK_VALUE_E 0

#define UIM_FALLBACK_SS_STYLE \
	textColor = "#ffff0000"; \
	backgroundColor = "#00ffffff"; \
	borderColor = "#00ff0000"; \
	lootbeamColor = "#ffff0000"; \
	menuTextColor = "#ffff0000"; \
	textAccent = 3; \
	fontType = 3; \
	showLootbeam = true; \
	menuSort = 50000; 

#define UIM_FALLBACK_S_STYLE \
	textColor = "#FFFFBFEA"; \
	backgroundColor = "#00FFBFEA"; \
	borderColor = "#00FFBFEA"; \
	lootbeamColor = "#FFFFBFEA"; \
	menuTextColor = "#FFFFBFEA"; \
	textAccent = 3; \
	fontType = 3; \
	showLootbeam = true; \
	menuSort = 40000; 

#define UIM_FALLBACK_A_STYLE \
	textColor = "#e6ffcc00"; \
	backgroundColor = "#00ffcc00"; \
	borderColor = "#00ffcc00"; \
	menuTextColor = "#ffffcc00"; \
	textAccent = 3; \
	fontType = 2; \
	menuSort = 30000; 

#define UIM_FALLBACK_B_STYLE \
	textColor = "#cc00c8ff"; \
	backgroundColor = "#0000c8ff"; \
	menuTextColor = "#ff00c9ff"; \
	textAccent = 3; \
	menuSort = 20000; 

#define UIM_FALLBACK_C_STYLE \
	textColor = "#997bff1f"; \
	backgroundColor = "#007bff1f"; \
	menuTextColor = "#ff7bff1f"; \
	textAccent = 3; \
	menuSort = 10000; 

#define UIM_FALLBACK_D_STYLE \
	textColor = "#ffffffff"; 

#define UIM_FALLBACK_E_STYLE \
	textColor = "#b3ffffff"; \
	textAccentColor = "#66000000";\
	menuSort = -10000; 

rule (ENABLE_UIM_DEATH_PILES && ((area:[3238, 6066, 0, 3284, 6102, 0] || area:[2958, 3335, 0, 2983, 3355, 0] || area:[3088, 3468, 0, 3092, 3470, 0] || area:[3042, 3480, 1, 3062, 3501, 1] || area:[2672, 3305, 0, 2678, 3312, 0]  || area:[1794, 9479, 0, 1856, 9538, 0]  || area:[3206, 9600, 0, 3237, 9628, 0]) && value:>=UIM_FALLBACK_VALUE_SS)) {UIM_FALLBACK_SS_STYLE}
rule (ENABLE_UIM_DEATH_PILES && ((area:[3238, 6066, 0, 3284, 6102, 0] || area:[2958, 3335, 0, 2983, 3355, 0] || area:[3088, 3468, 0, 3092, 3470, 0] || area:[3042, 3480, 1, 3062, 3501, 1] || area:[2672, 3305, 0, 2678, 3312, 0]  || area:[1794, 9479, 0, 1856, 9538, 0]  || area:[3206, 9600, 0, 3237, 9628, 0]) && value:>=UIM_FALLBACK_VALUE_S)) {UIM_FALLBACK_S_STYLE}
rule (ENABLE_UIM_DEATH_PILES && ((area:[3238, 6066, 0, 3284, 6102, 0] || area:[2958, 3335, 0, 2983, 3355, 0] || area:[3088, 3468, 0, 3092, 3470, 0] || area:[3042, 3480, 1, 3062, 3501, 1] || area:[2672, 3305, 0, 2678, 3312, 0]  || area:[1794, 9479, 0, 1856, 9538, 0]  || area:[3206, 9600, 0, 3237, 9628, 0]) && value:>=UIM_FALLBACK_VALUE_A)) {UIM_FALLBACK_A_STYLE}
rule (ENABLE_UIM_DEATH_PILES && ((area:[3238, 6066, 0, 3284, 6102, 0] || area:[2958, 3335, 0, 2983, 3355, 0] || area:[3088, 3468, 0, 3092, 3470, 0] || area:[3042, 3480, 1, 3062, 3501, 1] || area:[2672, 3305, 0, 2678, 3312, 0]  || area:[1794, 9479, 0, 1856, 9538, 0]  || area:[3206, 9600, 0, 3237, 9628, 0]) && value:>=UIM_FALLBACK_VALUE_B)) {UIM_FALLBACK_B_STYLE}
rule (ENABLE_UIM_DEATH_PILES && ((area:[3238, 6066, 0, 3284, 6102, 0] || area:[2958, 3335, 0, 2983, 3355, 0] || area:[3088, 3468, 0, 3092, 3470, 0] || area:[3042, 3480, 1, 3062, 3501, 1] || area:[2672, 3305, 0, 2678, 3312, 0]  || area:[1794, 9479, 0, 1856, 9538, 0]  || area:[3206, 9600, 0, 3237, 9628, 0]) && value:>=UIM_FALLBACK_VALUE_C)) {UIM_FALLBACK_C_STYLE}
rule (ENABLE_UIM_DEATH_PILES && ((area:[3238, 6066, 0, 3284, 6102, 0] || area:[2958, 3335, 0, 2983, 3355, 0] || area:[3088, 3468, 0, 3092, 3470, 0] || area:[3042, 3480, 1, 3062, 3501, 1] || area:[2672, 3305, 0, 2678, 3312, 0]  || area:[1794, 9479, 0, 1856, 9538, 0]  || area:[3206, 9600, 0, 3237, 9628, 0]) && value:>=UIM_FALLBACK_VALUE_D)) {UIM_FALLBACK_D_STYLE}
rule (ENABLE_UIM_DEATH_PILES && ((area:[3238, 6066, 0, 3284, 6102, 0] || area:[2958, 3335, 0, 2983, 3355, 0] || area:[3088, 3468, 0, 3092, 3470, 0] || area:[3042, 3480, 1, 3062, 3501, 1] || area:[2672, 3305, 0, 2678, 3312, 0]  || area:[1794, 9479, 0, 1856, 9538, 0]  || area:[3206, 9600, 0, 3237, 9628, 0]) && value:>=UIM_FALLBACK_VALUE_E)) {UIM_FALLBACK_E_STYLE}

/*@ define:module:food_and_pots
name: Food and Potions
subtitle: Never Forget your Pots Again
*/

/*@ define:input:food_and_pots
label: Food
type: stringlist
group: My Food and Potoins
*/

#define MYFOOD_NAMES ["Manta ray", "Dark crab", "Anglerfish", "Sea turtle", "Shark", "Cooked karambwan"] 

/*@ define:input:food_and_pots
label: Potions
type: stringlist
group: My Food and Potoins
*/

#define MYPOTS_NAMES ["Saradomin brew*", "Super restore*", "Ranging potion*", "Super combat potion*", "Prayer potion*", "Extended anti-venom+*", "Superantipoison*", "Stamina potion*", "Extended super antifire*", "Prayer regeneration*", "Goading potion*"]

/*@ define:input:food_and_pots
label: Food Style
type: style
group: Styles
exampleItem: Shark
*/

#define MYFOOD_STYLE \
    fontType = 3; \
	menuSort = 7500;

/*@ define:input:food_and_pots
label: Potion Style
type: style
group: Styles
exampleItem: Saradomin brew(4)
*/

#define MYPOTS_STYLE \
    fontType = 3; \
    showLootbeam = true; \
	menuSort = 7500;

rule (name:MYFOOD_NAMES && noted:false) {MYFOOD_STYLE}
rule (name:MYPOTS_NAMES && noted:false) {MYPOTS_STYLE}

/*@ define:input:food_and_pots
label: Supply Drops
type: style
group: Styles
exampleItem: Wild pie
*/

#define SUPPLY_DROP_STYLE \
    fontType = 2; \
	hidden = false; \
	menuSort = 5000; 
	
#define SUPPLY_DROP_RULESET(_area, _name) \
rule (area:_area && name:_name && (!ownership:2 || SHOW_OTHER_DROPS) && noted:false) {SUPPLY_DROP_STYLE}

