	color = "#ffb5c0c9"; \
	borderColor = "#ffb5c0c9"; \
	backgroundColor = "#ff636363"; \
	lootbeamColor = "#ffb5c0c9"; \
	showLootbeam = true;
	
apply (name:"Steel key *") {KEY_SHADES_STEEL}
 
