*/

/*@ define:input:uniques
label: SS Tier Uniques
type: style
*/
#define UNIQUE_SS_STYLE \
	color = "#ffff0000"; \
	borderColor = "#00ff0000"; \
	backgroundColor = "#00ffffff"; \
    showLootbeam = true; \
    textAccent = 3; \
    fontType = 3; \
	menuSort = 60000;\
    sound = "Unique_SS.wav";

/*@ define:input:uniques
label: S Tier Uniques
type: style
*/
#define UNIQUE_S_STYLE \
	color = "#ffd8b01a"; \
	borderColor = "#00d8b01a"; \
	backgroundColor = "#00d8b01a"; \
    showLootbeam = true; \
    textAccent = 3; \
    fontType = 3; \
	menuSort = 50000;\
    sound = "Unique_S.wav";

