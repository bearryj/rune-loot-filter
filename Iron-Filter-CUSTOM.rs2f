	color = "#ff000000"; \
	borderColor = "#ff000000"; \
	backgroundColor = "#ff3b3b3b"; \
	lootbeamColor = "#ff000000"; \
	showLootbeam = true; 
	
apply (name:"Black key *") {KEY_SHADES_BLACK}

