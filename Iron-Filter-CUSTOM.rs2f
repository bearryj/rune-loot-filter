/*@ define:module:header
hidden: true
name: header
*/

meta {
    name = "Iron Filter Custom";
    description = "A Filter for the Ironman Experience.     Turn off GE value and enjoy!";
	}

/*@ define:module:greetings
name: Welcome to Storn's Iron Filter
description:
    This is filter made for Ironman players. Sit back, relax, and turn off item value. Items are organized into different tiers base on value to ironman, rather than GE price. 
*/

/*@ define:module:settings
name: Settings
subtitle: Basic Global Settings 
*/

/*@ define:input:settings
label: World Spawns
type: boolean
group: Show
*/
#define SHOW_GLOBAL_DROPS false

apply (!SHOW_GLOBAL_DROPS && ownership:0) {hidden = true;}

/*@ define:input:settings
label: Unowned Drops
type: boolean
group: Show
*/
#define SHOW_OTHER_DROPS false

apply (!SHOW_OTHER_DROPS && ownership:2) {hidden = true;}

#define FORCE_SHOW_RULESET(_area, _name) \
rule (area:_area && name:_name && (!ownership:2 || SHOW_OTHER_DROPS)) {hidden = false;}

/*@ define:input:settings
label: Despawn Timer
type: boolean
group: Show
*/

#define SHOW_DEPSAWN_TIMER true

apply (SHOW_DEPSAWN_TIMER) {showDespawn = true;}

/*@ define:input:settings
label: Item Value
type: boolean
group: Show
*/

#define SHOW_ITEM_VALUE false

apply (SHOW_ITEM_VALUE) {showValue = true;}

/*@ define:input:settings
label: Item Icon
type: boolean
group: Show
*/

#define SHOW_ITEM_ICON false

apply (SHOW_ITEM_ICON) {icon = CurrentItem();}

/*@ define:input:settings
label: UIM Death Piles (Turns off filter) 
type: boolean
group: Show
*/

#define ENABLE_UIM_DEATH_PILES false

/*@ define:module:hidden
name: Hidden Items
subtitle: For when you NEVER want to see that item again  
*/

/*@ define:input:hidden
label: Hide All
type: stringlist
group: User
*/

#define HIDE_USER ["Leather gloves", "Leather boots", "Coif", "Leather body", "Leather chaps", "Leather cowl", "Leather vambraces", "Studded body", "Studded chaps","Frog-leather body","Frog-leather chaps", "Frog-leather boots","Snakeskin bandana","Snakeskin body","Snakeskin boots","Snakeskin chaps","Snakeskin vambraces","Shortbow","Oak shortbow","Willow shortbow","Maple shortbow","Yew shortbow","Magic shortbow","Longbow","Oak longbow","Willow longbow","Maple longbow","Yew longbow","Magic longbow","Dorgeshuun crossbow","Staff of air", "Staff of water", "Staff of earth", "Staff of fire", "magic staff","Staff", "Zamorak monk top", "Zamorak monk bottom","Blue wizard hat","Blue wizard robe","Blue skirt","Wizard hat","Black robe","Black skirt","Xerician hat","Xerician top","Xerician robe","Cake tin", "Pie dish", "Pot of flour", "Jug of water", "Bucket of water", "Bowl of water", "Bucket of milk", "Pineapple", "Raw shrimps", "Chopped garlic","Big fishing net", "Small fishing net", "Lobster pot", "Fishing rod", "Fly fishing rod", "Harpoon","Air talisman", "Mind talisman", "Water talisman", "Earth talisman", "Fire talisman", "Body talisman", "Cosmic talisman", "Chaos talisman", "Nature talisman", "Law talisman", "Wrath talisman","Bird snare", "Teasing stick", "Butterfly net", "Noose wand", "Rabbit snare","burnt *", "Ruined chompy", "Snake over-cooked", "Spider on shaft (burnt)","Bread", "Beer", "Asgarnian ale", "Cup of tea", "Beer tankard", "Keg of beer","Vial", "Pot", "Jug", "Bucket", "Bowl", "Barrel", "Beer glass", "Tankard","Hammer","Chisel","Rope","knife","Pestle and mortar","saw","shears","tinderbox","Gardening trowel","Rake","Secateurs","Seed dibber","Spade","Trowel","Watering can","Seaweed", "Waterskin*", "Doogle leaves", "Papyrus", "Broken glass", "Lit candle", "Candle", "King worm", "Tile", "Stone ball", "Silk", "Fingernails", "Rusty sword", "Red dye", "Cowhide","Rotten stymphike tartare"]

apply (name:HIDE_USER) {hidden=true;}

/*@ define:input:hidden
label: Hide if Unnoted
type: stringlist
group: User
*/

#define HIDE_USER_UNNOTED ["Green dragonhide","Blue dragonhide","Red dragonhide","Black dragonhide"]

apply (name:HIDE_USER_UNNOTED && stackable:false)  {hidden=true;}

/*@ define:input:hidden
label: Hide if quant < 10
type: stringlist
group: User
*/

#define HIDE_USER_UNDER_10 []

apply (name:HIDE_USER_UNDER_10 && quantity:<10) {hidden=true;}

/*@ define:input:hidden
label: Hide if quant < 100
type: stringlist
group: User
*/

#define HIDE_USER_UNDER_100 []

apply (name:HIDE_USER_UNDER_100 && quantity:<100) {hidden=true;}

/*@ define:input:hidden
label: Hide if quant < 1000
type: stringlist
group: User
*/

#define HIDE_USER_UNDER_1000 []

apply (name:HIDE_USER_UNDER_1000 && quantity:<1000) {hidden=true;}

/*@ define:input:hidden
label: Hide if quant < 10000
type: stringlist
group: User
*/

#define HIDE_USER_UNDER_10000 []

apply (name:HIDE_USER_UNDER_10000 && quantity:<10000) {hidden=true;}

/*@ define:input:hidden
label: Hide "Fake" Items
type: boolean
group: User
*/

#define ENABLE_HIDE_FAKE true

apply (ENABLE_HIDE_FAKE && id:[2513,4178,4180,6967,21060,31252]) {hidden=true;}

/*@ define:input:hidden
label: Hide on Boat
type: stringlist
group: Sailing
*/
#define HIDE_SAILING []

apply (area:[3838,6432,0,3896,6465,3] && name:HIDE_SAILING) {hidden=true;}

